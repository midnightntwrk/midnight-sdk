import CompactStandardLibrary;

// Mints a shielded coin to itself, which the standard library also claims, so its own Zswap state
// gains an output. Called from `cccMintCaller`, that output is a callee's, and the caller's state
// does not hold it.
export circuit mint(): [] {
  mintShieldedToken(
    pad(32, "ccc:minter"),
    1,
    pad(32, "ccc:minter:nonce"),
    right<ZswapCoinPublicKey, ContractAddress>(kernel.self())
  );
}
