{
  "name": "@midnight-ntwrk/compact-js",
  "version": "2.5.5-rc.8",
  "description": "Typescript-based execution environment for smart contracts compiled with the Compact language",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "types": "./dist/dts/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./effect": "./src/effect/index.ts",
    "./effect/*": "./src/effect/*.ts",
    "./effect/internal/*": null,
    "./v8": "./src/v8/index.ts",
    "./v8/effect": "./src/v8/effect.ts",
    "./v9": "./src/v9/index.ts",
    "./v9/effect": "./src/v9/effect.ts"
  },
  "dependencies": {
    "@effect/platform": "^0.97.0",
    "@midnight-ntwrk/compact-runtime": "0.19.0-rc.0",
    "@midnight-ntwrk/platform-js": "^3.0.0",
    "@midnightntwrk/ledger-v8": "8.1.2",
    "@midnightntwrk/ledger-v9": "^1.0.0-rc.4",
    "@noble/hashes": "^2.3.0",
    "compact-runtime-ledger8": "npm:@midnight-ntwrk/compact-runtime@0.16.0",
    "effect": "^3.22.1",
    "tslib": "^2.8.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/midnightntwrk/midnight-sdk.git"
  },
  "packageManager": "yarn@4.18.0",
  "author": "IOHK",
  "license": "Apache-2.0",
  "scripts": {
    "build": "yarn build-compact && yarn build-esm && yarn build-cjs && build-utils pack-v3 && yarn verify-exports",
    "build-esm": "tsc -b tsconfig.build.json",
    "build-cjs": "tsc -b tsconfig.cjs.json",
    "build-compact": "shx --negate test -d ./test/contract/managed && yarn compact || shx test -d ./test/contract/managed",
    "build-compact-v8": "shx --negate test -d ./test/contract/managed-v8 && yarn compact-v8 || shx test -d ./test/contract/managed-v8",
    "clean": "shx rm -rf ./build ./dist ./.tsbuildinfo ./reports ./coverage .tsbuildinfo",
    "test": "yarn build-compact && yarn build-compact-v8 && vitest run && vitest run --config vitest.era8.config.ts && tstyche",
    "package": "shx rm -rf ./dist/src && node ../scripts/resolve-workspace-protocol.mjs ./dist/package.json && (cd ./dist; npm pack)",
    "compact": "fetch-compactc && yarn compact-counter && yarn compact-unshielded && yarn compact-ccc-inner && yarn compact-ccc-middle && yarn compact-ccc-outer && yarn compact-ccc-self",
    "compact-v8": "COMPACTC_VERSION=0.31.1 fetch-compactc && yarn compact-v8-counter && yarn compact-v8-unshielded",
    "compact-v8-counter": "COMPACTC_VERSION=0.31.1 run-compactc ./test/contract/counter.compact ./test/contract/managed-v8/counter",
    "compact-v8-unshielded": "COMPACTC_VERSION=0.31.1 run-compactc ./test/contract/unshielded.compact ./test/contract/managed-v8/unshielded",
    "compact-counter": "run-compactc ./test/contract/counter.compact ./test/contract/managed/counter",
    "compact-unshielded": "run-compactc ./test/contract/unshielded.compact ./test/contract/managed/unshielded",
    "compact-ccc-inner": "run-compactc ./test/contract/cccInner.compact ./test/contract/managed/cccInner",
    "compact-ccc-middle": "run-compactc ./test/contract/cccMiddle.compact ./test/contract/managed/cccMiddle",
    "compact-ccc-outer": "run-compactc ./test/contract/cccOuter.compact ./test/contract/managed/cccOuter",
    "compact-ccc-self": "run-compactc ./test/contract/cccSelf.compact ./test/contract/managed/cccSelf",
    "verify-exports": "node ../scripts/verify-exports.mjs ."
  },
  "files": [
    "dist/"
  ]
}
