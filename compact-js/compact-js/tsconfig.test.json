{
  "extends": "../tsconfig.base.json",
  "include": ["test"],
  // `test/typetests` is tstyche's, and its negative cases (`expect().type.not.toBe`, a deliberately
  // misspelled circuit name) are *meant* to be type errors — tsc would read them as failures.
  // `test/era8` is excluded on a different basis: two of its files type the generated era-8
  // fixture as `new (witnesses) => never`, so every private state and circuit id downstream
  // collapses to `never`. The fixture is gitignored (`managed-v*/`), so it cannot be imported as a
  // type — its siblings write a structural type instead, which is the repair. Pre-existing debt,
  // tracked separately; not a property of this config.
  "exclude": ["test/typetests", "test/era8"],
  "references": [
    { "path": "tsconfig.src.json" },
  ],
  "compilerOptions": {
    "tsBuildInfoFile": ".tsbuildinfo/test.tsbuildinfo",
    "rootDir": "test",
    "noEmit": true
  }
}
