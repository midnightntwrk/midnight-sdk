{
  "$schema": "https://turbo.build/schema.v2.json",
  "envMode": "loose",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputLogs": "new-only",
      "inputs": [
        "src/**/*.ts",
        "!src/**/*.test.ts",
        "src/**/*.compact",
        "package.json",
        "../scripts/fix-esm-only-exports.mjs",
        "../scripts/verify-exports.mjs"
      ],
      "outputs": ["dist/**", "build/**", "src/**/managed/**"]
    },
    "clean": {
      "cache": false
    },
    "clean-build": {
      "cache": false,
      "dependsOn": [
        "clean",
        "build"
      ]
    },
    "build-fixtures": {
      "outputLogs": "new-only",
      "cache": false
    },
    "test": {
      "outputLogs": "new-only",
      "dependsOn": ["^build", "build-fixtures", "^build-fixtures"],
      "inputs": [
        "src/**/*.ts",
        "test/**/*.ts",
        "compose.yml",
        "tstyche.json",
        "vitest.config.ts",
        "vitest.era8.config.ts",
        "tsconfig*.json",
        "package.json"
      ],
      "outputs": ["reports/**", "coverage/**", "logs/**"]
    },
    "package": {
      "cache": false,
      "dependsOn": ["build"]
    }
  }
}
